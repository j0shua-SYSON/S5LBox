# Build output
/build/
# A second tree, because Windows will not relink an executable a running boot
# holds open: a 2-hour run in /build locks bootkernel.exe, and verifying a fix
# meanwhile needs somewhere else to link.
/build-verify/
**/build/
**/dist/
**/DerivedData/
/.tmp/
/.cache/
/.m5-lab/
/work/

# Python bytecode. The tools under tools/ are run directly and leave these
# behind; they are host- and version-specific and must never be committed.
__pycache__/
*.pyc

# XcodeGen output (generated from app/project.yml — never committed)
*.xcodeproj
*.xcworkspace
!default.xcworkspace

# Packaged app
*.ipa
Payload/

# Firmware / user-supplied artifacts — NEVER commit copyrighted Apple firmware.
# Users drop their own IPSW / keys here at runtime.
/firmware/
*.ipsw
*.img3
*.dmg
*.n88ap*
keys.json
*.img
ios3vm_nand_*.img

# Python wheels an agent may fetch to cross-check semantics (e.g. unicorn)
*.whl

# Agent scratch worktrees (created inside the repo by isolated subagents)
/.claude/worktrees/

# Editor / OS cruft
.DS_Store
.vscode/
.idea/
*.o
*.obj
*.a
*.exe
compile_commands.json

# Agent scratch config (codex CLI)
/.codex/

# Guest console tee, written into the CWD by -F runs (see the CONSOLE CAPTURE block)
uart-console.log

# Raw uart4 byte stream, written into the CWD by --ppp runs (see UART4 / PPP).
# The bytes belong to a run, so they are kept beside its manifest under work/.
uart4-ppp.bin
